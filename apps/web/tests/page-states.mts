const results: Array<Record<string, unknown>> = [];
let forwardedApiWrites = 0;
const publicBefore = await fetch('http://127.0.0.1:3100/api/display').then(response => response.json());
const filter = process.env.CASE_FILTER;
await writeFile(new URL('page-state-catalog.json', output), JSON.stringify(cases.map(test => ({ id: test.id, page: test.pageId, state: test.state })), null, 2));
const selected = filter ? cases.filter(test => test.id.includes(filter)) : cases;
for (const test of selected) {
  const context = await browser.newContext({ viewport: { width: 390, height: 844 }, acceptDownloads: true });
  const page = await context.newPage();
  const f = fixtures(test.options);
  const requests: RequestInfo[] = [];
  const pageErrors: string[] = [];
  page.on('pageerror', error => pageErrors.push(error.message));
  await page.route('**/api/**', async route => {
    try {
      const request = route.request();
      const info: RequestInfo = { path: new URL(request.url()).pathname, method: request.method(), body: request.method() === 'GET' ? null : request.postDataJSON(), index: requests.length };
      requests.push(info);
      const reply = test.reply?.(info, f) ?? (info.method === 'GET' ? defaultReply(info.path, f, test.options ?? {}) : failure('BAD_REQUEST', 400, '夹具：此视图用例未定义该写响应'));
      if (reply.delay) await new Promise(resolve => setTimeout(resolve, reply.delay));
      if (reply.abort) await route.abort();
      else if (reply.text !== undefined) await route.fulfill({ status: reply.status, contentType: 'text/csv', body: reply.text });
      else await route.fulfill({ status: reply.status, json: reply.body });
    } catch (error) { pageErrors.push(`fixture boundary: ${String(error)}`); await route.abort().catch(() => {}); }
  });
  const started = Date.now();
  try {
    await test.init?.(page, f);
    await page.goto(`${origin}/#${test.route}`, { waitUntil: 'domcontentloaded' });
    if (test.tab) await page.getByRole('tab', { name: test.tab, exact: true }).click();
    await test.check(page, requests, f);
    assert.deepEqual(pageErrors, [], 'browser runtime and schema fixture errors');
    if (test.snapshot) await page.screenshot({ path: fileURLToPath(new URL(`${test.id}.png`, output)), fullPage: true });
    results.push({ id: test.id, page: test.pageId, state: test.state, result: 'PASS', durationMs: Date.now() - started, evidence: 'schema-checked browser response fixture; view/navigation only', fixtureRequests: requests.length, fixtureWriteResponses: requests.filter(request => request.method !== 'GET').length });
  } catch (error) {
    await page.screenshot({ path: fileURLToPath(new URL(`${test.id}-FAIL.png`, output)), fullPage: true }).catch(() => {});
    results.push({ id: test.id, page: test.pageId, state: test.state, result: 'FAIL', error: String(error), pageErrors, durationMs: Date.now() - started, evidence: 'schema-checked browser response fixture; view/navigation only' });
  } finally { await context.close(); }
  const last = results.at(-1)!;
  console.log(`${last.result} ${test.id}${last.result === 'FAIL' ? ` ${last.error}` : ''}`);
