type F = ReturnType<typeof fixtures>;
type RequestInfo = { path: string; method: string; body: Record<string, unknown> | null; index: number };
type Case = { id: string; pageId: string; state: string; route: string; options?: FixtureOptions; tab?: string; reply?: (request: RequestInfo, f: F) => Reply | undefined; check: (page: Page, requests: RequestInfo[], f: F) => Promise<void>; init?: (page: Page, f: F) => Promise<void>; snapshot?: boolean };
const cases: Case[] = [];
const text = async (page: Page, value: string) => { await page.getByText(value, { exact: false }).first().waitFor({ state: 'visible', timeout: 3500 }); };
const absent = async (page: Page, value: string) => { assert.equal(await page.getByText(value, { exact: false }).count(), 0, `must hide ${value}`); };
const disabled = async (page: Page, name: string, expected = true) => { assert.equal(await page.getByRole('button', { name, exact: false }).first().isDisabled(), expected, name); };
const add = (value: Case) => cases.push(value);
const view = (id: string, pageId: string, state: string, route: string, expected: string, options: FixtureOptions = {}, extra: Partial<Case> = {}) => add({ id, pageId, state, route, options, check: page => text(page, expected), ...extra });
const errorRead = (target: string, code: Parameters<typeof failure>[0] = 'SERVER_BUSY', status = 503) => (request: RequestInfo) => request.path === target ? failure(code, status) : undefined;
const loadingRead = (target: string) => (request: RequestInfo, f: F) => request.path === target ? { ...defaultReply(target, f, {}), delay: 1200 } : undefined;
async function seedRun(page: Page, f: F, corrupt = false): Promise<void> {
  const record = { version: 1, start: { idempotency_key: ids.instance, game_id: 'stack', client_instance_id: ids.instance, controller_secret: 's'.repeat(43), build: f.session.build }, session: f.session, inputs: [], processedTick: 1, logDigest: corrupt ? 'corrupted-prefix' : createHash('sha256').update('{"inputs":[],"tick":1}').digest('hex'), sealed: null };
  await page.evaluate(async ({ storageKey, record }) => {
    await new Promise<void>((resolve, reject) => { const open = indexedDB.open('sheep-onsite-v2.1', 1); open.onupgradeneeded = () => open.result.createObjectStore('records'); open.onerror = () => reject(open.error); open.onsuccess = () => { const db = open.result; const tx = db.transaction('records', 'readwrite'); tx.objectStore('records').put(record, storageKey); tx.oncomplete = () => { db.close(); resolve(); }; tx.onerror = () => reject(tx.error); }; });
  }, { storageKey: `run:${ids.participant}`, record });
}

