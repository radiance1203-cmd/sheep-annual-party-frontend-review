import { chromium } from 'playwright';
import { mkdir, writeFile } from 'node:fs/promises';
const out='output/r2-20261027/candidates';await mkdir(out,{recursive:true});const browser=await chromium.launch({headless:true});const results:object[]=[];
try{for(const candidate of ['r2e','r2f2'])for(const width of [320,390,430]){const page=await browser.newPage({viewport:{width,height:844},deviceScaleFactor:2});const errors:string[]=[];page.on('pageerror',e=>errors.push(e.message));await page.goto(`http://127.0.0.1:5175/tests/r2-preview.html?game=stack&candidate=${candidate}`);await page.waitForFunction(()=>Boolean((window as any).r2));await page.evaluate(()=>{(window as any).r2.advanceTicks(150);(window as any).r2.freeze(500);});await page.waitForTimeout(100);const d=await page.evaluate(()=>(window as any).r2.diagnostics());await page.screenshot({path:`${out}/stack-${candidate}-${width}.png`,fullPage:true});results.push({candidate,width,errors,tick:d.coreTick,phase:d.displayTime,actors:d.scene.sprites,scope:'one static stack_idle candidate + existing v4 other actions/scenery; not complete new animation'});await page.close();}}finally{await browser.close();}await writeFile(`${out}/results.json`,JSON.stringify({results},null,2));console.log(JSON.stringify({out,count:results.length}));
