 }
}}finally{await writeFile(`${out}/captures.json`,JSON.stringify({at:new Date().toISOString(),scope:catalog.scope+' Production renderer + preloadAssets; synchronous presentation replay of every actual core view. Standalone harness, not GamePage business UI. Debug overlay only reads frozen rules/core positions.',manifestHash,artVersion:manifest.art_version,browser:browser.version(),build:catalog.build,rulesFileHash:catalog.rulesFileHash,captures,errors},null,2));await browser.close();}
assert.deepEqual(errors,[]);console.log(JSON.stringify({captures:captures.length,out}));
