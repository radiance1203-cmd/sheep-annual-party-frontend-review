  await page.goto('http://127.0.0.1:5175/audit-art-renderer');await page.waitForFunction(()=>Boolean(window.artHarness));await page.evaluate(async({trajectory,manifestHash})=>window.artHarness!.load(trajectory,manifestHash),{trajectory,manifestHash});
  for(const c of relevant.sort((a,b)=>a.tick-b.tick||a.id.localeCompare(b.id))){const metrics=await page.evaluate(async tick=>window.artHarness!.advance(tick),c.tick) as HarnessMetrics;assert.equal(metrics.viewHash,c.viewHash,`${c.id}: browser core-derived view hash`);assert.ok(metrics.decoded.every(i=>i.width>0&&i.height>0));assert.ok(metrics.scrollWidth<=viewport.width,`${c.id}: no horizontal overflow`);const sx=metrics.canvas.rect.width/metrics.world.width,sy=metrics.canvas.rect.height/metrics.world.height;assert.ok(Math.abs(sx-sy)<.01,`${c.id}: uniform FIT`);assert.ok(metrics.controls.every(e=>e.width>=48&&e.height>=48&&e.font>=16));
   const prefix=`${out}/${c.id}-${viewport.width}x${viewport.height}`;await page.screenshot({path:`${prefix}.png`,fullPage:true});if(c.primary){await page.evaluate(()=>window.artHarness!.debug(true));await page.screenshot({path:`${prefix}-geometry.png`,fullPage:true});await page.evaluate(()=>window.artHarness!.debug(false));}captures.push({id:c.id,game:c.game,trajectory:c.trajectory,tick:c.tick,viewHash:metrics.viewHash,prefixHash:c.prefixHash,viewport,metrics,features:c.features,path:`${prefix}.png`,geometryPath:c.primary?`${prefix}-geometry.png`:null});
  }
