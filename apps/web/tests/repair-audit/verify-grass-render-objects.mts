import {chromium} from 'playwright';
import {readFile,writeFile,mkdir} from 'node:fs/promises';
import {createHash} from 'node:crypto';
import assert from 'node:assert/strict';
import type {ArtCatalog} from './art-contracts';
const base='output/repair-20261027/audit/art-runtime';const out=process.argv[2]?`${base}/${process.argv[2]}`:base;await mkdir(out,{recursive:true});const catalog=JSON.parse(await readFile(`${base}/core-derived-states.json`,'utf8')) as ArtCatalog;const trajectory=catalog.trajectories.find(t=>t.id==='runner-golden')!;const manifestHash=createHash('sha256').update(await readFile('apps/web/public/assets/asset-manifest.v1.json')).digest('hex');const browser=await chromium.launch({headless:true});const page=await browser.newPage({viewport:{width:390,height:844}});const checks:unknown[]=[];let pass=false;
try{await page.route('**/api/**',r=>r.abort());await page.route('**/audit-grass-render',r=>r.fulfill({contentType:'text/html',body:'<style>body{font:16px system-ui;margin:8px}#stage{width:360px;position:relative;overflow:hidden}</style><h1>Standalone actual prop object audit</h1><div id="stage"><svg id="geometry" hidden></svg></div><p id="state"></p><button id="toggle">Geometry</button><script type="module" src="/tests/repair-audit/art-harness.ts"></script>'}));await page.goto('http://127.0.0.1:5175/audit-grass-render');await page.waitForFunction(()=>Boolean(window.artHarness));await page.evaluate(async({trajectory,manifestHash})=>window.artHarness!.load(trajectory,manifestHash),{trajectory,manifestHash});for(const id of ['runner-grass-uncollected','runner-grass-outer-only','runner-grass-both']){const c=catalog.cases.find(c=>c.id===id)!;const m=await page.evaluate(tick=>window.artHarness!.advance(tick),c.tick);assert.equal(m.viewHash,c.viewHash);assert.equal(m.view.game_id,'runner');if(m.view.game_id!=='runner')throw Error('game');const grass=m.view.grass.find(g=>g.grass_id===1)!;const near=m.renderedFrames.filter(f=>Math.abs(f.x-grass.center.x_u/1000)<.001&&Math.abs(f.y-grass.center.y_u/1000)<.001);const outer=near.some(f=>f.frame==='clover_outer_round'),inner=near.some(f=>f.frame==='clover_core_round');const runnerIndex=m.renderedFrames.findIndex(f=>f.texture==='sheep_side_v1');const coreDrawIndex=m.renderedFrames.findIndex(f=>f.frame==='clover_core_round'&&Math.abs(f.x-grass.center.x_u/1000)<.001&&Math.abs(f.y-grass.center.y_u/1000)<.001);assert.equal(outer,!grass.outer_collected);assert.equal(inner,!grass.inner_collected);checks.push({id,tick:c.tick,viewHash:c.viewHash,grass,outerFramePresent:outer,coreFramePresent:inner,coreDrawIndex,runnerIndex,coreAboveRunner:coreDrawIndex>runnerIndex,actualPropFrames:near,runner:m.renderedFrames[runnerIndex]});await page.screenshot({path:`${out}/${id}.png`,fullPage:true});if(process.argv[2]&&c.tick===240)assert.ok(coreDrawIndex>runnerIndex,'Uncollected golden core at tick240 must draw after opaque runner');}pass=true;}finally{await writeFile(`${out}/grass-render-objects.json`,JSON.stringify({at:new Date().toISOString(),scope:'Actual production renderer image/frame objects at true golden core prefixes. Explicit remaining-core draw-order target; no state, collider or pickup-radius edits.',manifestHash,pass,checks},null,2));await browser.close();}console.log(JSON.stringify({pass,checks:checks.length}));
